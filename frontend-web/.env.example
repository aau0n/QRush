# QRush 프론트엔드 웹 환경변수 (.env로 복사해서 사용)
#
# A 서버 주소 — 같은 와이파이에서 A의 IP로. 비우면 mock 모드.
VITE_API_BASE_URL=http://<A의-IP>:3000

# 신뢰 발급기관 지갑 주소 (B가 IssuerRegistry에 등록한 주소).
VITE_ISSUER_ADDRESS=0x0000000000000000000000000000000000000000

# D 앱(frontend-app) 주소 — 예매/입장 QR이 가리키는 HTTP fallback 대상.
# 비우면 'C 웹을 연 호스트:5174'로 자동 추정. 보통 D 앱이 다른 IP/포트면 명시.
# VITE_DAPP_BASE_URL=http://192.168.0.20:5174

# (선택) 공연 목록 실엔드포인트. 비우면 mock 공연 목록 사용.
# VITE_EVENTS_PATH=/api/events
